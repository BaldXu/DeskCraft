<?xml version="1.0" encoding="utf-8"?>
<!-- 数字时钟 widget 布局（M3）。

     背景由 ClockWidgetProvider 按配置绘制成 Bitmap 塞进 widget_bg
     （支持纯色 / 预置渐变 / 任意圆角，与 Flutter 预览一致）；
     文本仍由系统 TextClock 零功耗驱动，属性默认值仅作首帧兜底，
     实际颜色 / 字号 / 格式由 Provider 按配置覆盖。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="a h:mm"
            android:format24Hour="HH:mm"
            android:singleLine="true"
            android:textColor="@color/widget_primary"
            android:textSize="38sp" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="M月d日 EEEE"
            android:format24Hour="M月d日 EEEE"
            android:singleLine="true"
            android:textColor="@color/widget_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="DeskCraft - M1"
            android:textColor="@color/widget_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
